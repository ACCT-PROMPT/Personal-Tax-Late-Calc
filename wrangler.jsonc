{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-tax-late-calc",
  "account_id": "f1668ab342bbb4bf7e2dabb3abebf43e",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "tax-late-calc.acctprompt.com"
    }
  ],
  "services": [
    {
      "binding": "MEMBER_EDGE",
      "service": "acctprompt-domain"
    }
  ],
  "main": "worker/index.js"
}
